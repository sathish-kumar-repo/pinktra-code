0:{"buildId":"w4m0BANkv3APw_VBejrXa","data":[{"rsc":["$","$1","c",{"children":[["$","$L2",null,{"children":[["$","h1",null,{"children":"Privacy Policy"}],["$","p",null,{"children":"Your privacy matters to us. This Privacy Policy explains how Pinktra collects, uses, stores, and protects information when you use our website, learning resources, products, and development services. By using Pinktra, you agree to this Privacy Policy."}],["$","h2",null,{"children":"1. Information We Collect"}],["$","p",null,{"children":"Pinktra is designed to minimize data collection. We do not require you to create an account or provide personal information to access most of our learning resources."}],["$","p",null,{"children":"We may collect limited information such as:"}],["$","ul",null,{"children":[["$","li",null,{"children":"Browser and device information."}],["$","li",null,{"children":"Anonymous usage statistics."}],["$","li",null,{"children":"Theme, language, and other website preferences stored locally."}],["$","li",null,{"children":"Information you voluntarily provide through email or contact forms."}]]}],["$","h2",null,{"children":"2. Cookies and Local Storage"}],["$","p",null,{"children":"Pinktra uses cookies and similar technologies to improve your browsing experience. These may be used to remember preferences such as theme, language, and other website settings."}],["$","p",null,{"children":"These technologies are not used to identify you personally."}],["$","h2",null,{"children":"3. How We Use Information"}],["$","p",null,{"children":"Any information we receive is used only to:"}],["$","ul",null,{"children":[["$","li",null,{"children":"Improve the platform and user experience."}],["$","li",null,{"children":"Maintain website functionality."}],["$","li",null,{"children":"Respond to inquiries or support requests."}],["$","li",null,{"children":"Improve learning resources, products, and development services."}]]}],["$","h2",null,{"children":"4. Third-Party Services"}],["$","p",null,{"children":"Pinktra may link to third-party websites, tools, repositories, or services. Their privacy practices are independent of ours, and we encourage you to review their policies before providing any personal information."}],["$","h2",null,{"children":"5. Data Security"}],["$","p",null,{"children":"We take reasonable measures to protect information and maintain the security of the platform. However, no internet transmission or storage system can be guaranteed to be completely secure."}],["$","h2",null,{"children":"6. Children's Privacy"}],["$","p",null,{"children":"Pinktra is not intended to knowingly collect personal information from children. If you believe a child has provided personal information, please contact us so appropriate action can be taken."}],["$","h2",null,{"children":"7. Policy Updates"}],["$","p",null,{"children":"This Privacy Policy may be updated periodically to reflect improvements, legal requirements, or changes to the platform. Updates become effective once published on this page."}],["$","h2",null,{"children":"8. Contact"}],["$","p",null,{"children":["If you have any questions about this Privacy Policy or how Pinktra handles information, please contact us at ",["$","strong",null,{"children":"pinktra.mail@gmail.com"}],"."]}]]}],[["$","link","0",{"rel":"stylesheet","href":"/_next/static/chunks/2yo0r1qzg6ihk.css","precedence":"next"}],["$","script","script-0",{"src":"/_next/static/chunks/3m3nirw_6xgj_.js","async":true}]],["$","$L3",null,{"children":["$","$4",null,{"name":"Next.MetadataOutlet","children":"$@5"}]}]]}],"isPartial":"$@6","staleTime":"$7","varyParams":null},{"rsc":["$","$1","h",{"children":[null,["$","$L8",null,{"children":[["$","meta","0",{"charSet":"utf-8"}],["$","meta","1",{"name":"viewport","content":"width=device-width, initial-scale=1"}],["$","meta","2",{"name":"theme-color","content":"#f0b4d7"}],["$","meta","3",{"name":"color-scheme","content":"light dark"}]]}],["$","div",null,{"hidden":true,"children":["$","$L9",null,{