8:["$","div",null,{"className":"hp-creator-details","children":[["$","div",null,{"className":"hp-creator-block hp-glass","children":[["$","h3",null,{"children":"🧭 Philosophy"}],["$","p",null,{"children":"Knowledge without structure is noise. Pinktra is built on the belief that organized, well-explained knowledge is worth more than scattered information."}]]}],["$","div",null,{"className":"hp-creator-block hp-glass","children":[["$","h3",null,{"children":"🎯 Focus Areas"}],["$","p",null,{"children":"Web development, AI tools, trading systems, personal finance, and building practical products that make learning easier to apply."}]]}],["$","div",null,{"className":"hp-creator-block hp-glass","children":[["$","h3",null,{"children":"🌱 Goals"}],["$","p",null,{"children":"Grow Pinktra into a platform where anyone can learn a new domain, use a tool built for it, and get expert help building something of their own."}]]}],["$","div",null,{"className":"hp-creator-block hp-glass","children":[["$","h3",null,{"children":"🔭 Vision"}],["$","p",null,{"children":"Become one of the most trusted places to learn, build, and grow — for individuals and businesses alike."}]]}]]}]
9:["$","section",null,{"className":"hp-section hp-journey","children":["$","div",null,{"className":"hp-container","children":[["$","div",null,{"className":"hp-section-label","children":"Our Story"}],["$","h2",null,{"className":"hp-section-title","children":"How Pinktra Came to Be"}],["$","p",null,{"className":"hp-section-sub","children":"From a small collection of notes to a connected platform for learning, products, and services — this is the story of Pinktra."}],["$","div",null,{"className":"hp-timeline","children":[[["$","div","2020",{"className":"hp-timeline-item left","children":[["$","div",null,{"className":"hp-timeline-card hp-glass","children":[["$","span",null,{"className":"hp-timeline-year","children":"2020"}],["$","h3",null,{"children":"The Idea Takes Shape"}],["$","p",null,{"children":"What became Pinktra started as a small effort to organize notes and study material — the first seed of a structured knowledge system."}]]}],["$","div",null,{"className":"hp-timeline-dot"}]]}],["$","div","2021",{"className":"hp-timeline-item right","children":[["$","div",null,{"className":"hp-timeline-card hp-glass","children":[["$","span",null,{"className":"hp-timeline-year","children":"2021"}],["$","h3",null,{"children":"Going Digital"}],["$","p",null,{"children":"Notes moved online. The first version of a structured, searchable knowledge system was built."}]]}],["$","div",null,{"className":"hp-timeline-dot"}]]}],["$","div","2022",{"className":"hp-timeline-item left","children":[["$","div",null,{"className":"hp-timeline-card hp-glass","children":[["$","span",null,{"className":"hp-timeline-year","children":"2022"}],["$","h3",null,{"children":"Expanding Domains"}],["$","p",null,{"children":"Coverage grew beyond the original scope to include finance, trading, and personal development."}]]}],["$","div",null,{"className":"hp-timeline-dot"}]]}],["$","div","2023",{"className":"hp-timeline-item right","children":[["$","div",null,{"className":"hp-timeline-card hp-glass","children"