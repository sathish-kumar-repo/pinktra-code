a:["$","section",null,{"className":"hp-section hp-testimonials","children":["$","div",null,{"className":"hp-container","children":[["$","div",null,{"className":"hp-section-label","children":"What People Say"}],["$","h2",null,{"className":"hp-section-title","children":"Trusted by Learners & Builders"}],["$","p",null,{"className":"hp-section-sub","children":"Real feedback from people using Pinktra to learn, build, and ship — across guides, products, and custom development work."}],["$","$L1c",null,{"testimonials":[{"quote":"Pinktra is the first place I go when I want to actually understand something, not just skim a summary. The guides are clear without being dumbed down.","name":"Kumar P.","role":"Frontend Developer","image":{"src":"/_next/static/media/kumar.1amahui6qgb-a.webp","width":666,"height":666,"blurWidth":8,"blurHeight":8,"blurDataURL":"data:image/webp;base64,"}},{"quote":"I started using the Trading Journal after reading through the finance section, and it just clicked. Learning and the tools live in the same place, which makes a real difference.","name":"Raja B.","role":"Self-Taught Trader","image":{"src":"/_next/static/media/raja.16xmrrugq_0j4.webp","width":1110,"height":1110,"blurWidth":8,"blurHeight":8,"blurDataURL":"data:image/webp;base64,"}},{"quote":"As someone who codes for a living, I still learn something new from the technology section every week. It respects your time and your intelligence.","name":"Athiyaman A.","role":"Backend Engineer","image":{"src":"/_next/static/media/athiyaman.29e7ulmni3jvb.webp","width":1182,"height":1182,"blurWidth":8,"blurHeight":8,"blurDataURL":"data:image/webp;base64,"}},{"quote":"We needed a custom web app on a tight timeline and Pinktra's team delivered exactly what we asked for, plus a few smart suggestions we hadn't considered.","name":"Sulthan Alavutheen A.","role":"Graduate Student","image":{"src":"/_next/static/media/sulthan.13vhhowe9qhji.webp","width":1227,"height":1227,"blurWidth":8,"blurHeight":8,"blurDataURL":"data:image/webp;base64,"}}]}]]}]}]
b:["$","section",null,{"className":"hp-section hp-faq hp-highlights","children":["$","div",null,{"className":"hp-container hp-faq-container","children":[["$","div",null,{"className":"hp-section-label","children":"Frequently Asked Questions"}],["$","h2",null,{"className":"hp-section-title","children":"Common Questions Answered"}],["$","$L1d",null,{"faqs":[{"q":"What is Pinktra?","a":"Pinktra is a learning and digital products platform. It helps people learn across many domains — like technology, finance, health, and business — and provides practical tools and products to put that knowledge to work."},{"q":"What can I learn on Pinktra?","a":"Pinktra covers a wide range of knowledge domains, including technology, programming, AI, science, finance, business, health, productivity, and more — all organized into clear guides, tutorials, and references."},{"q":"Is Pinktra free?","a":"Yes. All learning content on Pinktra is completely free and accessible to everyone."},{"q":"What types of products does Pinktra offer?","a":"Pinktra builds its own digital products, such as a Habit Tracker and a Trading Journal, along with other productivity and developer tools designed to be genuinely useful."},{"q":"Can I suggest a topic?","a":"Absolutely. Suggestions, corrections, and ideas for new topics are always welcome."},{"q":"Can I use Pinktra's products on mobile?","a":"Yes. Pinktra is fully responsive, and its products are designed to work well on both desktop and mobile devices."},{"q":"Does Pinktra build custom applications?","a":"Yes. Beyond learning and products, Pinktra offers professional development services — including websites, web apps, mobile apps, and custom software built for customers."},{"q":"How can I request a development service?","a":"Visit the Services page to see what Pinktra offers, browse the Work page to see past projects, and get in touch to discuss your project."}]}]]}]}]
